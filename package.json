{
  "name": "cyberpunk-neon-survivors",
  "version": "1.0.0",
  "description": "High-octane top-down cyberpunk neon action shooter with procedural lighting and Web Audio synthwave",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:clean": "node -e \"fs.rmSync('./dist', { recursive: true, force: true });\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/**/*.test.ts",
    "test:concurrency": "tsx --test tests/concurrency.test.ts",
    "ci": "npm run typecheck && npm run test && npm run build",
    "deploy": "node scripts/deploy.js",
    "deploy:vercel": "vercel --prod",
    "deploy:vercel:preview": "vercel"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "supertest": "^7.3.1",
    "@types/supertest": "^7.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
